# Copy this file to .env and fill in the values:  cp .env.example .env

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────
# Used by Prisma (see prisma/schema.prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/social?schema=public

# ─── Auth ─────────────────────────────────────────────────
# Use long random strings, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ─── CORS (allowed frontend origins) ──────────────────────
DEV_ORIGIN=http://localhost:3000
PROD_ORIGIN=https://your-frontend.example.com

# ─── Email (Brevo HTTPS API) — verification codes & password reset ───
BREVO_API_KEY=
EMAIL_FROM=no-reply@jafarmahmoud.sy

# ─── Media uploads (ImageKit) ─────────────────────────────
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_ENDPOINT=https://upload.imagekit.io/api/v1/files/upload

# ─── Deployment (optional, used only for the startup log URL) ──
RAILWAY_STATIC_URL=
RENDER_STATIC_URL=
